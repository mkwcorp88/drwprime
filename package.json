{
  "name": "drwprime",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit --incremental false",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "treatments:sync": "tsx scripts/sync-treatments.ts",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:treatment-ops": "tsx prisma/seed-treatment-ops.ts",
    "ops:bootstrap-admin": "tsx prisma/bootstrap-treatment-ops-admin.ts",
    "ops:import-md": "tsx prisma/import-ops-md.ts",
    "ops:import-fee": "tsx prisma/import-fee-master.ts",
    "db:local": "node scripts/start-local-db.mjs",
    "dev:ops": "next dev --hostname 0.0.0.0 --port 3010",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@base-ui/react": "^1.7.0",
    "@clerk/nextjs": "^6.35.1",
    "@payloadcms/db-postgres": "3.75.0",
    "@payloadcms/next": "3.75.0",
    "@payloadcms/richtext-lexical": "3.75.0",
    "@payloadcms/storage-s3": "^3.75.0",
    "@prisma/client": "^5.22.0",
    "argon2": "^0.45.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "graphql": "^16.14.2",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.31.0",
    "next": "^15.5.12",
    "payload": "3.75.0",
    "pdf-lib": "^1.17.1",
    "prisma": "^5.22.0",
    "qrcode.react": "^4.2.0",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "recharts": "^3.8.0",
    "shadcn": "^4.16.2",
    "sharp": "^0.35.1",
    "swiper": "^12.2.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.4.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "eslint": "^9",
    "eslint-config-next": "15.5.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vercel": "^54.10.2",
    "vitest": "^4.1.10"
  }
}
